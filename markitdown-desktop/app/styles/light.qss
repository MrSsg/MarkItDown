QMainWindow, QWidget { background: @BG@; color: @TEXT@; font-family: "Microsoft YaHei", "Segoe UI"; font-size: 13px; }
QFrame#queuePane, QFrame#detailPane, QFrame#HistoryPanel { background: @CARD@; border: 1px solid @BORDER@; border-radius: 12px; }
QLabel#brandMark { background: @BRAND@; color: white; border-radius: 9px; font-size: 18px; font-weight: 700; }
QLabel#workspaceTitle { font-size: 18px; font-weight: 700; }
QLabel#workspaceSubtitle, QLabel#mutedText, QLabel#statusLine { color: @MUTED@; }
QLabel#paneTitle { color: @TEXT@; font-size: 15px; font-weight: 700; }
QPushButton { background: transparent; border: 1px solid @BORDER@; border-radius: 7px; padding: 7px 12px; color: @BODY@; }
QPushButton:hover { background: @HOVER@; border-color: @BRAND@; color: @BRAND@; }
QPushButton#primaryAction { background: @BRAND@; border-color: @BRAND@; color: white; font-weight: 700; }
QPushButton#primaryAction:hover { background: #2869DD; color: white; }
QPushButton#dangerBtn { color: @ERROR@; }
QPushButton#themeToggle { min-width: 36px; max-width: 36px; min-height: 36px; max-height: 36px; padding: 0; border-radius: 10px; }
QPushButton#dropZone { border: 2px dashed @BRAND@; color: @BRAND@; background: @HOVER@; font-size: 14px; }
QPushButton:disabled { color: @MUTED@; background: @BG@; border-color: @BORDER@; }
QListWidget { background: @CARD@; border: 1px solid @BORDER@; border-radius: 8px; padding: 4px; outline: none; }
QListWidget::item { padding: 10px; border-radius: 6px; }
QListWidget::item:selected { background: @HOVER@; color: @BRAND@; }
QListWidget::item:hover { background: @HOVER@; }
QTextBrowser#markdownPreview { background: @BG@; border: 1px solid @BORDER@; border-radius: 8px; padding: 8px; }
QProgressBar { border: 1px solid @BORDER@; border-radius: 5px; text-align: center; background: @BG@; }
QProgressBar::chunk { background: @BRAND@; border-radius: 4px; }
QDockWidget::title { background: @CARD@; color: @TEXT@; padding: 8px; }
QSplitter::handle { background: @BORDER@; width: 1px; }
QGroupBox { border: 1px solid @BORDER@; border-radius: 8px; margin-top: 10px; padding: 10px; }
