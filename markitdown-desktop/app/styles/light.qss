/* MarkItDownDesk Light Theme v0.11.5 */

/* ── Root Background ──────────────── */
QMainWindow {
    background-color: #F7F8FC;
    color: #4E5969;
}

/* ── TopNavBar ────────────────────── */
QFrame#TopNavBar {
    background: #FFFFFF;
    border-bottom: 1px solid #E5E6EB;
}
QFrame#TopNavBar QLabel {
    background: transparent;
    color: #1D2129;
}
QFrame#TopNavBar QPushButton {
    background: transparent;
    color: #86909C;
    border: none;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 13px;
}
QFrame#TopNavBar QPushButton:hover {
    color: #6366F1;
    background: #F5F6FA;
}
QFrame#TopNavBar QPushButton[navBtn="true"] {
    color: #86909C;
}
QFrame#TopNavBar QPushButton[navBtn="true"]:hover {
    color: #6366F1;
}

/* ── Cards ────────────────────────── */
QFrame#CardWidget, QFrame#HistoryPanel {
    background-color: #FFFFFF;
    border: 1px solid #E5E6EB;
    border-radius: 16px;
}
QLabel#cardTitle {
    color: #1D2129;
    font-size: 15px;
    font-weight: 600;
}
QPushButton#collapseBtn {
    background: transparent;
    color: #86909C;
    border: none;
    border-radius: 6px;
}
QPushButton#collapseBtn:hover {
    background: #F5F6FA;
    color: #4E5969;
}
QWidget#cardContent {
    background: transparent;
}

/* ── History Panel ────────────────── */
QFrame#HistoryPanel QLabel {
    background: transparent;
    color: #4E5969;
}

/* ── Push Buttons ─────────────────── */
QPushButton {
    background-color: #6366F1;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 6px 16px;
    min-height: 24px;
    font-size: 13px;
}
QPushButton:hover {
    background-color: #818CF8;
}
QPushButton:pressed {
    background-color: #2B6BEF;
}
QPushButton:disabled {
    background-color: #CCCCCC;
    color: #FFFFFF;
}
QPushButton#secondaryBtn {
    background-color: #F5F6FA;
    color: #4E5969;
    border: 1px solid #E5E6EB;
}
QPushButton#secondaryBtn:hover {
    background-color: #EEF2FF;
    border-color: #6366F1;
}
QPushButton#primaryAction {
    background-color: #6366F1;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#primaryAction:hover {
    background-color: #818CF8;
}
QPushButton#iconBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
    font-size: 18px;
}
QPushButton#iconBtn:hover {
    background: #F5F6FA;
}
QPushButton#toolBtn {
    background: transparent;
    color: #4E5969;
    border: 1px solid #E5E6EB;
    border-radius: 8px;
    padding: 4px 12px;
    font-size: 13px;
}
QPushButton#toolBtn:hover {
    border-color: #6366F1;
    color: #6366F1;
    background: #F5F6FA;
}
QPushButton#navBtn {
    background: transparent;
    color: #86909C;
    border: none;
    padding: 6px 14px;
    font-size: 14px;
    border-radius: 6px;
}
QPushButton#navBtn:hover {
    color: #1D2129;
    background: #F5F6FA;
}
QPushButton#histActionBtn {
    color: #F53F3F;
    background: transparent;
    border: none;
    font-size: 12px;
}
QPushButton#histActionBtn:hover {
    color: #FF7070;
}

/* ── Drop Zone ────────────────────── */
QLabel#UploadDropZone {
    border: 2px dashed #C9CDD4;
    border-radius: 16px;
    background: #FAFBFC;
    color: #86909C;
    font-size: 13px;
}
QLabel#UploadDropZone:hover {
    border-color: #6366F1;
    background: #F0F7FF;
    color: #6366F1;
}

/* ── TextBrowser ──────────────────── */
QTextBrowser {
    background-color: #FFFFFF;
    color: #4E5969;
    border: 1px solid #E5E6EB;
    border-radius: 12px;
    padding: 12px;
    selection-background-color: #EEF2FF;
}

/* ── ListWidget ───────────────────── */
QListWidget {
    background-color: #FFFFFF;
    color: #4E5969;
    border: 1px solid #E5E6EB;
    border-radius: 8px;
    outline: none;
}
QListWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #F5F6FA;
}
QListWidget::item:hover {
    background-color: #F5F6FA;
}
QListWidget::item:selected {
    background-color: #EEF2FF;
    color: #6366F1;
}

/* ── GroupBox ─────────────────────── */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E5E6EB;
    border-radius: 12px;
    margin-top: 12px;
    padding: 16px 12px 12px;
    font-weight: 600;
    color: #1D2129;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #1D2129;
}

/* ── Splitter ─────────────────────── */
QSplitter::handle {
    background-color: #E5E6EB;
}
QSplitter::handle:hover {
    background-color: #6366F1;
}
QSplitter::handle:horizontal {
    width: 4px;
    margin: 2px 0;
}
QSplitter::handle:vertical {
    height: 4px;
    margin: 0 2px;
}

/* ── StatusBar / Status Label ─────── */
QLabel#statusLabel {
    color: #86909C;
    font-size: 12px;
    padding: 2px 16px;
    background: #FFFFFF;
    border-top: 1px solid #E5E6EB;
}

/* ── ComboBox ─────────────────────── */
QComboBox {
    background-color: #FFFFFF;
    color: #4E5969;
    border: 1px solid #E5E6EB;
    border-radius: 8px;
    padding: 4px 8px;
    min-height: 22px;
}
QComboBox:focus {
    border-color: #6366F1;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #4E5969;
    selection-background-color: #EEF2FF;
    border: 1px solid #E5E6EB;
    border-radius: 8px;
}

/* ── SpinBox ──────────────────────── */
QSpinBox {
    background-color: #FFFFFF;
    color: #4E5969;
    border: 1px solid #E5E6EB;
    border-radius: 8px;
    padding: 4px 8px;
    min-height: 22px;
}
QSpinBox:focus {
    border-color: #6366F1;
}

/* ── Radio / Check ────────────────── */
QRadioButton, QCheckBox {
    color: #4E5969;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #C9CDD4;
    background: #FFFFFF;
}
QCheckBox::indicator:checked {
    background-color: #6366F1;
    border-color: #6366F1;
    image: url(assets/check.png);
}
QCheckBox::indicator:hover {
    border-color: #6366F1;
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 10px;
    border: 2px solid #C9CDD4;
    background: #FFFFFF;
}
QRadioButton::indicator:checked {
    background-color: #FFFFFF;
    border: 2px solid #6366F1;
}
QRadioButton::indicator:hover {
    border-color: #6366F1;
}

/* ── Dialog ───────────────────────── */
QDialog {
    background-color: #F7F8FC;
    color: #4E5969;
}
QDialog QLabel {
    background: transparent;
    color: #4E5969;
}
QDialog QGroupBox {
    color: #1D2129;
}
QDialogButtonBox QPushButton {
    min-width: 72px;
}

/* ── ScrollBar ────────────────────── */
QScrollBar:vertical {
    background: #F7F8FC;
    width: 8px;
    margin: 0;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #C9CDD4;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #407BFF;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: #F7F8FC;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #C9CDD4;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #407BFF;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Nav Title ──────────────────────── */
QLabel#navTitle {
    font-size: 16px;
    font-weight: 600;
    margin-left: 10px;
    margin-right: 40px;
    color: #1D2129;
}

/* ── ToolTip ──────────────────────── */
QToolTip {
    background-color: #FFFFFF;
    color: #1D2129;
    border: 1px solid #E5E6EB;
    border-radius: 8px;
    padding: 4px 8px;
}

/* ── QStackedWidget ───────────────── */
QStackedWidget {
    background: transparent;
}
