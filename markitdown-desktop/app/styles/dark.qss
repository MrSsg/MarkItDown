/* ── MarkConvert Desk Dark Theme ─────────────────── */
/* Based on design spec: bg #12141A, card #1C1F28, brand #818CF8 */

/* ── Global ─────────────────────────────────────────── */
QMainWindow, QDialog, QWidget {
    background-color: #12141A;
    color: #F5F7FA;
    font-family: "Microsoft YaHei", "Segoe UI", "Inter", system-ui, sans-serif;
    font-size: 14px;
}

/* ── Top Bar ────────────────────────────────────────── */
#TopBar {
    background-color: #1C1F28;
    border-bottom: 1px solid #303643;
    min-height: 64px;
    max-height: 64px;
}

#TopBar QPushButton#navBtn {
    background: transparent;
    border: none;
    color: #C9CDD4;
    font-size: 14px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 8px;
}
#TopBar QPushButton#navBtn:hover {
    background-color: #272B36;
    color: #818CF8;
}

#TopBar QPushButton#toolBtn {
    background: transparent;
    border: 1px solid #303643;
    color: #C9CDD4;
    font-size: 15px;
    font-weight: 500;
    padding: 6px 16px;
    border-radius: 8px;
    min-height: 32px;
}
#TopBar QPushButton#toolBtn:hover {
    background-color: #818CF8;
    color: #FFFFFF;
    border-color: #818CF8;
}
#TopBar QPushButton#toolBtn:pressed {
    background-color: #3068E0;
}

#TopBar QPushButton#iconBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
    min-width: 36px;
    min-height: 36px;
    font-size: 18px;
    color: #C9CDD4;
}
#TopBar QPushButton#iconBtn:hover {
    background-color: #272B36;
}

/* ── Cards ──────────────────────────────────────────── */
#CardWidget {
    background-color: #1C1F28;
    border: 1px solid #303643;
    border-radius: 16px;
}

#CardWidget QLabel#cardTitle {
    color: #F5F7FA;
    font-size: 18px;
    font-weight: 600;
}

#CardWidget QPushButton#collapseBtn {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px;
    font-size: 16px;
    color: #86909C;
    min-width: 28px;
    min-height: 28px;
}
#CardWidget QPushButton#collapseBtn:hover {
    background-color: #272B36;
    color: #818CF8;
}

/* ── Drop Area ──────────────────────────────────────── */
#dropArea {
    background-color: #12141A;
    border: 2px dashed #303643;
    border-radius: 12px;
    min-height: 140px;
}
#dropArea:hover, #dropArea[dragOver="true"] {
    background-color: #272B36;
    border-color: #818CF8;
}

#dropIcon {
    color: #818CF8;
    font-size: 32px;
}
#dropText {
    color: #C9CDD4;
    font-size: 15px;
    font-weight: 500;
}
#dropHint {
    color: #86909C;
    font-size: 12px;
}

/* ── File List Items ────────────────────────────────── */
#FileItem {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 8px;
}
FileItem:hover {
    background-color: #272B36;
    border-color: #303643;
}

#FileItem QLabel#fileName {
    color: #F5F7FA;
    font-size: 14px;
    font-weight: 500;
}
#FileItem QLabel#fileSize {
    color: #86909C;
    font-size: 12px;
}
#FileItem QPushButton#removeBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
    font-size: 14px;
    color: #86909C;
    min-width: 22px;
    min-height: 22px;
}
#FileItem QPushButton#removeBtn:hover {
    background-color: #F8717130;
    color: #F87171;
}

/* ── Standard Push Buttons ──────────────────────────── */
QPushButton {
    background-color: #818CF8;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 15px;
    font-weight: 500;
    min-height: 36px;
}
QPushButton:hover {
    background-color: #5A8FFF;
}
QPushButton:pressed {
    background-color: #3068E0;
}
QPushButton:disabled {
    background-color: #272B36;
    color: #5A5E66;
}

QPushButton#secondaryBtn {
    background: transparent;
    border: 1px solid #303643;
    color: #C9CDD4;
}
QPushButton#secondaryBtn:hover {
    background-color: #272B36;
    border-color: #818CF8;
    color: #818CF8;
}

QPushButton#dangerBtn {
    background: transparent;
    border: 1px solid #303643;
    color: #F87171;
}
QPushButton#dangerBtn:hover {
    background-color: #F8717120;
    border-color: #F87171;
}

/* ── Primary Action Button (Convert) ────────────────── */
QPushButton#primaryAction {
    background-color: #818CF8;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 10px 28px;
    font-size: 16px;
    font-weight: 600;
    min-height: 42px;
}
QPushButton#primaryAction:hover {
    background-color: #5A8FFF;
}
QPushButton#primaryAction:pressed {
    background-color: #3068E0;
}

/* ── QTextBrowser (Markdown Preview) ────────────────── */
QTextBrowser {
    background-color: #1C1F28;
    color: #F5F7FA;
    border: 1px solid #303643;
    border-radius: 12px;
    padding: 16px;
    selection-background-color: #818CF850;
}
QTextBrowser:focus {
    border-color: #818CF8;
}

/* ── QListWidget (History) ──────────────────────────── */
QListWidget {
    background-color: #1C1F28;
    color: #C9CDD4;
    border: 1px solid #303643;
    border-radius: 12px;
    outline: none;
    padding: 4px;
}
QListWidget::item {
    padding: 8px 12px;
    border-radius: 8px;
    border-bottom: 1px solid #272B36;
}
QListWidget::item:hover {
    background-color: #272B36;
}
QListWidget::item:selected {
    background-color: #818CF8;
    color: #FFFFFF;
}

/* ── History Panel ──────────────────────────────────── */
#HistoryPanel {
    background-color: #1C1F28;
    border: 1px solid #303643;
    border-radius: 16px;
}

#HistoryPanel QPushButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    color: #86909C;
    min-height: 24px;
}
#HistoryPanel QPushButton:hover {
    background-color: #272B36;
    color: #818CF8;
}

/* ── GroupBox ───────────────────────────────────────── */
QGroupBox {
    background-color: #1C1F28;
    border: 1px solid #303643;
    border-radius: 12px;
    margin-top: 16px;
    padding: 20px 16px 16px 16px;
    font-weight: 600;
    font-size: 15px;
    color: #F5F7FA;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 6px;
}

/* ── StatusBar ──────────────────────────────────────── */
QStatusBar {
    background-color: #1C1F28;
    color: #86909C;
    border-top: 1px solid #303643;
    padding: 2px 12px;
    font-size: 12px;
}
QStatusBar QLabel {
    color: #86909C;
    font-size: 12px;
}

/* ── ScrollBar ──────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3A3E48;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #4A4E58;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #3A3E48;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #4A4E58;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── Lines / Separators ─────────────────────────────── */
QFrame#separator {
    background-color: #303643;
    max-height: 1px;
}

/* ── Dialog ─────────────────────────────────────────── */
QDialog {
    background-color: #12141A;
}
QDialog QLabel {
    color: #F5F7FA;
}

/* ── LineEdit / SpinBox / ComboBox ──────────────────── */
QLineEdit, QSpinBox, QComboBox {
    background-color: #12141A;
    color: #F5F7FA;
    border: 1px solid #303643;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 14px;
    min-height: 28px;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #818CF8;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #1C1F28;
    color: #F5F7FA;
    selection-background-color: #818CF8;
    selection-color: #FFFFFF;
    border: 1px solid #303643;
    border-radius: 8px;
    padding: 4px;
}
QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 4px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #272B36;
}

/* ── CheckBox / RadioButton ─────────────────────────── */
QCheckBox, QRadioButton {
    color: #F5F7FA;
    font-size: 14px;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #303643;
}
QCheckBox::indicator:checked {
    background-color: #818CF8;
    border-color: #818CF8;
    image: url(assets/check.png);
    image: url(assets/check.png);
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 10px;
    border: 2px solid #303643;
}
QRadioButton::indicator:checked {
    background-color: #818CF8;
    border-color: #818CF8;
}

/* ── Slider ─────────────────────────────────────────── */
QSlider::groove:horizontal {
    background: #303643;
    height: 6px;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #818CF8;
    width: 18px;
    height: 18px;
    margin: -6px 0;
    border-radius: 9px;
}
QSlider::sub-page:horizontal {
    background: #818CF8;
    border-radius: 3px;
}

/* ── ToolTip ────────────────────────────────────────── */
QToolTip {
    background-color: #1C1F28;
    color: #F5F7FA;
    border: 1px solid #303643;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Menu ───────────────────────────────────────────── */
QMenu {
    background-color: #1C1F28;
    color: #F5F7FA;
    border: 1px solid #303643;
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 8px 32px 8px 16px;
    border-radius: 6px;
    font-size: 14px;
}
QMenu::item:selected {
    background-color: #272B36;
    color: #818CF8;
}
QMenu::separator {
    height: 1px;
    background: #303643;
    margin: 4px 8px;
}

/* ── Header Label ───────────────────────────────────── */
QLabel#appTitle {
    color: #F5F7FA;
    font-size: 22px;
    font-weight: 600;
}
QLabel#cardTitle {
    color: #F5F7FA;
    font-size: 18px;
    font-weight: 600;
}
QLabel {
    color: #C9CDD4;
    font-size: 14px;
}
QLabel#caption {
    color: #86909C;
    font-size: 12px;
}

/* ── PlainTextEdit (Raw MD View) ────────────────────── */
QPlainTextEdit {
    background-color: #1C1F28;
    color: #F5F7FA;
    border: 1px solid #303643;
    border-radius: 12px;
    padding: 12px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
    selection-background-color: #818CF850;
}
QPlainTextEdit:focus {
    border-color: #818CF8;
}

/* ── ProgressBar ────────────────────────────────────── */
QProgressBar {
    background-color: #12141A;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    font-size: 10px;
}
QProgressBar::chunk {
    background-color: #818CF8;
    border-radius: 4px;
}

/* Splitters */
QSplitter::handle {
    background: #555;
}
QSplitter::handle:horizontal { width: 4px; margin: 2px 0; }
QSplitter::handle:vertical { height: 4px; margin: 0 2px; }
