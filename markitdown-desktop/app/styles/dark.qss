QMainWindow {
    background: @BG@;
}
QWidget {
    color: @TEXT@;
    font-family: "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
}
QLabel, QCheckBox, QRadioButton { background: transparent; }
QFrame#queuePane, QFrame#detailPane, QFrame#HistoryPanel {
    background: @CARD@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}
QFrame#optionsPane { background: @HOVER@; border: 1px solid @BORDER@; border-radius: 8px; }
QLabel#floatSummary { color: @TEXT@; font-size: 12px; font-weight: 700; }
QPushButton#floatAction { background: @BRAND_STRONG@; border-color: @BRAND_STRONG@; color: @BRAND_ON@; padding: 5px 8px; }
QLabel#brandMark {
    background: @BRAND_STRONG@;
    color: @BRAND_ON@;
    border-radius: 9px;
    font-size: 18px;
    font-weight: 700;
}
QLabel#workspaceTitle { font-size: 18px; font-weight: 700; }
QLabel#workspaceSubtitle, QLabel#mutedText, QLabel#statusLine { color: @MUTED@; }
QLabel#paneTitle { color: @TEXT@; font-size: 15px; font-weight: 700; }
QLabel#queueSummary, QLabel#progressMeta { color: @BODY@; }
QLabel#statusBadge { padding: 3px 8px; border-radius: 6px; }
QLabel#statusBadge[status="success"] { color: @SUCCESS@; background: @SUCCESS_BG@; }
QLabel#statusBadge[status="warning"] { color: @WARNING@; background: @WARNING_BG@; }
QLabel#statusBadge[status="error"] { color: @ERROR@; background: @ERROR_BG@; }
QPushButton, QToolButton {
    background: transparent;
    border: 1px solid @BORDER@;
    border-radius: 7px;
    padding: 7px 12px;
    color: @BODY@;
}
QPushButton:hover, QToolButton:hover { background: @HOVER@; border-color: @BRAND@; color: @BRAND_TEXT@; }
QPushButton:checked { background: @HOVER@; border-color: @BRAND@; color: @BRAND_TEXT@; }
QPushButton:pressed, QToolButton:pressed { background: @HOVER@; border-color: @BRAND_STRONG@; }
QPushButton:focus, QToolButton:focus, QCheckBox:focus, QRadioButton:focus,
QSpinBox:focus, QListWidget:focus, QTextBrowser:focus {
    border: 2px solid @FOCUS@;
}
QPushButton#headerImport { border-color: @BRAND@; color: @BRAND_TEXT@; font-weight: 700; }
QPushButton#primaryAction {
    background: @BRAND_STRONG@;
    border-color: @BRAND_STRONG@;
    color: @BRAND_ON@;
    font-weight: 700;
}
QPushButton#primaryAction:hover { background: @BRAND@; border-color: @BRAND@; color: @BRAND_ON@; }
QPushButton#dangerBtn { color: @ERROR@; }
QPushButton#themeToggle { min-width: 40px; max-width: 40px; min-height: 40px; max-height: 40px; padding: 0; border-radius: 10px; }
QPushButton#dropZone { border: 2px dashed @BRAND@; color: @BRAND_TEXT@; background: @HOVER@; font-size: 14px; }
QPushButton:disabled, QToolButton:disabled { color: @MUTED@; background: @BG@; border-color: @BORDER@; }
QToolButton#moreButton, QToolButton#headerMore { padding: 7px 12px; }
QListWidget {
    background: @CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px;
}
QListWidget::item { padding: 8px 10px; border-radius: 6px; }
QListWidget::item:disabled { color: @MUTED@; }
QLabel#queueEmptyState { color: @MUTED@; background: transparent; }
QListWidget::item:selected { background: @HOVER@; color: @BRAND_TEXT@; }
QListWidget::item:hover { background: @HOVER@; }
QTextBrowser#markdownPreview { background: @BG@; border: 1px solid @BORDER@; border-radius: 8px; padding: 8px; }
QProgressBar { border: 1px solid @BORDER@; border-radius: 5px; text-align: center; background: @BG@; min-height: 12px; }
QProgressBar::chunk { background: @BRAND_STRONG@; border-radius: 4px; }
QDockWidget::title { background: @CARD@; color: @TEXT@; padding: 8px; }
QSplitter::handle { background: @BORDER@; width: 1px; height: 1px; }
QGroupBox { border: 1px solid @BORDER@; border-radius: 8px; margin-top: 10px; padding: 10px; }
QGroupBox::title { color: @TEXT@; subcontrol-origin: margin; left: 10px; padding: 0 4px; background: @CARD@; }
QScrollArea { border: none; background: transparent; }
QToolTip { background: @CARD@; color: @TEXT@; border: 1px solid @BORDER@; padding: 5px 8px; }
