/* MarkItDownDesk Dark Theme v0.11.5 */

/* ── Root Background ──────────────── */
QMainWindow {
    background-color: #12141A;
    color: #C9CDD4;
}

/* ── TopNavBar ────────────────────── */
QFrame#TopNavBar {
    background: #1C1F28;
    border-bottom: 1px solid #303643;
}
QFrame#TopNavBar QLabel {
    background: transparent;
    color: #F5F7FA;
}
QFrame#TopNavBar QPushButton {
    background: transparent;
    color: #86909C;
    border: none;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 13px;
}
QFrame#TopNavBar QPushButton:hover {
    color: #407BFF;
    background: #272B36;
}
QFrame#TopNavBar QPushButton[navBtn="true"] {
    color: #86909C;
}
QFrame#TopNavBar QPushButton[navBtn="true"]:hover {
    color: #407BFF;
}

/* ── Cards (CollapsibleCard / HistoryPanel) ── */
QFrame#CardWidget, QFrame#HistoryPanel {
    background-color: #1C1F28;
    border: 1px solid #303643;
    border-radius: 16px;
}
QLabel#cardTitle {
    color: #F5F7FA;
    font-size: 15px;
    font-weight: 600;
}
QPushButton#collapseBtn {
    background: transparent;
    color: #86909C;
    border: none;
    border-radius: 6px;
}
QPushButton#collapseBtn:hover {
    background: #272B36;
    color: #C9CDD4;
}
QWidget#cardContent {
    background: transparent;
}

/* ── History Panel ────────────────── */
QFrame#HistoryPanel QLabel {
    background: transparent;
    color: #C9CDD4;
}

/* ── Push Buttons ─────────────────── */
QPushButton {
    background-color: #407BFF;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 6px 16px;
    min-height: 24px;
    font-size: 13px;
}
QPushButton:hover {
    background-color: #5695FF;
}
QPushButton:pressed {
    background-color: #2B6BEF;
}
QPushButton:disabled {
    background-color: #303643;
    color: #666666;
}
QPushButton#secondaryBtn {
    background-color: #272B36;
    color: #C9CDD4;
    border: 1px solid #303643;
}
QPushButton#secondaryBtn:hover {
    background-color: #303643;
    border-color: #407BFF;
}
QPushButton#primaryAction {
    background-color: #407BFF;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#primaryAction:hover {
    background-color: #5695FF;
}
QPushButton#iconBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
    font-size: 18px;
}
QPushButton#iconBtn:hover {
    background: #272B36;
}
QPushButton#toolBtn {
    background: transparent;
    color: #C9CDD4;
    border: 1px solid #303643;
    border-radius: 8px;
    padding: 4px 12px;
    font-size: 13px;
}
QPushButton#toolBtn:hover {
    border-color: #407BFF;
    color: #407BFF;
    background: #272B36;
}
QPushButton#navBtn {
    background: transparent;
    color: #86909C;
    border: none;
    padding: 6px 14px;
    font-size: 14px;
    border-radius: 6px;
}
QPushButton#navBtn:hover {
    color: #F5F7FA;
    background: #272B36;
}
QPushButton#histActionBtn {
    color: #F53F3F;
    background: transparent;
    border: none;
    font-size: 12px;
}
QPushButton#histActionBtn:hover {
    color: #FF7070;
}

/* ── Drop Zone ────────────────────── */
QLabel#UploadDropZone {
    border: 2px dashed #303643;
    border-radius: 16px;
    background: #1C1F28;
    color: #86909C;
    font-size: 13px;
}
QLabel#UploadDropZone:hover {
    border-color: #407BFF;
    background: #1E2433;
    color: #407BFF;
}

/* ── TextBrowser ──────────────────── */
QTextBrowser {
    background-color: #1C1F28;
    color: #C9CDD4;
    border: 1px solid #303643;
    border-radius: 12px;
    padding: 12px;
    selection-background-color: #407BFF40;
}

/* ── ListWidget ───────────────────── */
QListWidget {
    background-color: #1C1F28;
    color: #C9CDD4;
    border: 1px solid #303643;
    border-radius: 8px;
    outline: none;
}
QListWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #272B36;
}
QListWidget::item:hover {
    background-color: #272B36;
}
QListWidget::item:selected {
    background-color: #407BFF30;
    color: #407BFF;
}

/* ── GroupBox ─────────────────────── */
QGroupBox {
    background-color: #1C1F28;
    border: 1px solid #303643;
    border-radius: 12px;
    margin-top: 12px;
    padding: 16px 12px 12px;
    font-weight: 600;
    color: #F5F7FA;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #F5F7FA;
}

/* ── Splitter ─────────────────────── */
QSplitter::handle {
    background-color: #303643;
}
QSplitter::handle:hover {
    background-color: #407BFF;
}
QSplitter::handle:horizontal {
    width: 4px;
    margin: 2px 0;
}
QSplitter::handle:vertical {
    height: 4px;
    margin: 0 2px;
}

/* ── StatusBar / Status Label ─────── */
QLabel[statusLabel="true"], QLabel#statusLabel {
    color: #86909C;
    font-size: 12px;
    padding: 2px 16px;
    background: #1C1F28;
    border-top: 1px solid #303643;
}

/* ── QComboBox ────────────────────── */
QComboBox {
    background-color: #272B36;
    color: #C9CDD4;
    border: 1px solid #303643;
    border-radius: 8px;
    padding: 4px 8px;
    min-height: 22px;
}
QComboBox:focus {
    border-color: #407BFF;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #1C1F28;
    color: #C9CDD4;
    selection-background-color: #407BFF30;
    border: 1px solid #303643;
    border-radius: 8px;
}

/* ── QSpinBox ─────────────────────── */
QSpinBox {
    background-color: #272B36;
    color: #C9CDD4;
    border: 1px solid #303643;
    border-radius: 8px;
    padding: 4px 8px;
    min-height: 22px;
}
QSpinBox:focus {
    border-color: #407BFF;
}

/* ── Radio / Check ────────────────── */
QRadioButton, QCheckBox {
    color: #C9CDD4;
    spacing: 6px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #303643;
    background: #1C1F28;
}
QCheckBox::indicator:checked {
    background-color: #407BFF;
    border-color: #407BFF;
    image: url(assets/check.png);
}
QCheckBox::indicator:hover {
    border-color: #407BFF;
}
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 10px;
    border: 2px solid #303643;
    background: #1C1F28;
}
QRadioButton::indicator:checked {
    background-color: #1C1F28;
    border: 2px solid #407BFF;
}
QRadioButton::indicator:hover {
    border-color: #407BFF;
}

/* ── Dialog ───────────────────────── */
QDialog {
    background-color: #12141A;
    color: #C9CDD4;
}
QDialog QLabel {
    background: transparent;
    color: #C9CDD4;
}
QDialog QGroupBox {
    color: #F5F7FA;
}
QDialogButtonBox QPushButton {
    min-width: 72px;
}

/* ── ScrollBar ────────────────────── */
QScrollBar:vertical {
    background: #12141A;
    width: 8px;
    margin: 0;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #303643;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #407BFF;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: #12141A;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #303643;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #407BFF;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Nav Title ──────────────────────── */
QLabel#navTitle {
    font-size: 16px;
    font-weight: 600;
    margin-left: 10px;
    margin-right: 40px;
    color: #F5F7FA;
}

/* ── ToolTip ──────────────────────── */
QToolTip {
    background-color: #1C1F28;
    color: #F5F7FA;
    border: 1px solid #303643;
    border-radius: 8px;
    padding: 4px 8px;
}

/* ── QStackedWidget ───────────────── */
QStackedWidget {
    background: transparent;
}
